{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "../data/*": ["src/stubs/data/*"],
      "../hooks/*": ["src/stubs/hooks/*"],
      "../lib/*": ["src/stubs/lib/*"],
      "./RainMathGame": ["src/RainMathGame"],
      "./Memorama": ["src/Memorama"],
      "../components/RainMathGame": ["src/RainMathGame"],
      "../components/Memorama": ["src/Memorama"]
    }
  },
  "include": ["src"]
}
